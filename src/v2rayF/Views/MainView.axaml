<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:v2rayF.ViewModels"
             xmlns:models="using:v2rayF.Models"
             xmlns:views="using:v2rayF.Views"
             x:Class="v2rayF.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
            <StackPanel Grid.Row="0" Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="v2rayF" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AppVersionLabel, StringFormat='v{0} · Sentinel'}"
                                   Opacity="0.55" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            VerticalAlignment="Center"
                            Padding="12,8"
                            MinWidth="88"/>
                    <Button Grid.Column="2"
                            Content="{Binding UpdateButtonText}"
                            Command="{Binding UpdateChromeCommand}"
                            IsVisible="{Binding ShowUpdateChrome}"
                            IsEnabled="{Binding !IsUpdating}"
                            Classes="accent"
                            VerticalAlignment="Center"
                            Padding="12,8"
                            MinWidth="96"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" PlaceholderText="Subscription URL"
                             Text="{Binding SubscriptionUrl}"/>
                    <Button Grid.Column="1" Content="Import" Command="{Binding ImportFromSubscriptionCommand}"/>
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshSubscriptionCommand}"
                            IsEnabled="{Binding HasSavedSubscription}"/>
                    <Button Grid.Column="3" Content="File" Command="{Binding ImportConfigFileCommand}"/>
                </Grid>

                <TextBox AcceptsReturn="True" MinHeight="56" MaxHeight="96"
                         PlaceholderText="Paste share link / JSON / bulk"
                         Text="{Binding ImportText}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Paste" Command="{Binding ImportFromClipboardCommand}"
                            VerticalAlignment="Top" MinHeight="40"/>
                    <Button Content="Add" Command="{Binding ImportFromTextCommand}"
                            VerticalAlignment="Top" MinHeight="40"/>
                </StackPanel>

                <Button Content="{Binding ConnectButtonText}" Classes="accent"
                        Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding CanToggleConnection}"
                        HorizontalAlignment="Stretch" MinHeight="48"/>

                <StackPanel Orientation="Horizontal" Spacing="16"
                            IsVisible="{Binding ShowTrafficStats}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UploadTrafficText}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding DownloadTrafficText}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding ConnectedPingText}" FontWeight="SemiBold" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test delay" Command="{Binding TestLatencyCommand}" IsEnabled="{Binding HasSelectedServer}"/>
                    <Button Content="Test All" Command="{Binding TestAllLatencyCommand}" IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasSelectedServer}"/>
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1"
                     x:Name="ServerList"
                     ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     SelectionMode="Single"
                     Tapped="ServerList_Tapped">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:ProxyServer">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <Border Padding="6,3" CornerRadius="4" Background="{DynamicResource SystemAccentColor}">
                                <TextBlock Text="{Binding DisplayProtocol}" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DisplayTransport}" FontSize="11" Opacity="0.85"/>
                                <TextBlock Text="{Binding DisplayEndpoint}" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayLatency}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3"
                                    Content="×"
                                    ToolTip.Tip="Remove this server"
                                    Padding="10,4"
                                    MinWidth="44"
                                    MinHeight="36"
                                    FontSize="18"
                                    VerticalAlignment="Center"
                                    Tag="{Binding}"
                                    Click="RemoveServer_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CoreStatus}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border IsVisible="{Binding SettingsOpen}"
                Background="#99000000"
                Padding="16">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="12"
                    Padding="12">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Done" Command="{Binding CloseSettingsCommand}"
                                MinHeight="40" MinWidth="88"/>
                    </Grid>
                    <views:SettingsPanel/>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
