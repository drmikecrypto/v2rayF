<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:v2rayF.ViewModels"
        xmlns:models="using:v2rayF.Models"
        xmlns:views="using:v2rayF.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1024"
        d:DesignHeight="720"
        x:Class="v2rayF.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="v2rayF Sentinel"
        Width="1024"
        Height="720"
        MinWidth="800"
        MinHeight="560">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="v2rayF"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersionLabel, StringFormat='v{0} · Sentinel'}"
                               Opacity="0.55" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Settings"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        MinWidth="96">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Closed="SettingsFlyout_Closed">
                            <Border Width="400" MaxHeight="560" Padding="8"
                                    DataContext="{Binding $parent[Window].DataContext}">
                                <views:SettingsPanel/>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2"
                        Content="{Binding UpdateButtonText}"
                        Command="{Binding UpdateChromeCommand}"
                        IsVisible="{Binding ShowUpdateChrome}"
                        IsEnabled="{Binding !IsUpdating}"
                        Classes="accent"
                        VerticalAlignment="Center"
                        Padding="14,8"
                        MinWidth="100"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         PlaceholderText="Subscription URL (https://...)"
                         Text="{Binding SubscriptionUrl}"/>
                <Button Grid.Column="1" Content="Import URL" Command="{Binding ImportFromSubscriptionCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshSubscriptionCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="3" Content="Clipboard" Command="{Binding ImportFromClipboardCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="4" Content="File" Command="{Binding ImportConfigFileCommand}" IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="5" Content="{Binding ConnectButtonText}" Classes="accent"
                        Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanToggleConnection}" MinWidth="120"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" AcceptsReturn="True" MinHeight="56" MaxHeight="80"
                         PlaceholderText="Paste share links, Xray JSON, or bulk list (vmess/vless/ss/trojan)"
                         Text="{Binding ImportText}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" VerticalAlignment="Stretch" Content="Import"
                        Command="{Binding ImportFromTextCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="96"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,16" BorderThickness="1" CornerRadius="8" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="Servers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Test delay" Command="{Binding TestLatencyCommand}" IsEnabled="{Binding HasSelectedServer}"/>
                    <Button Content="Test All" Command="{Binding TestAllLatencyCommand}" IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasSelectedServer}"/>
                </StackPanel>

                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         SelectionMode="Single"
                         DoubleTapped="ServerList_DoubleTapped">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:ProxyServer">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Padding="6,3" CornerRadius="4"
                                        Background="{DynamicResource SystemAccentColor}">
                                    <TextBlock Text="{Binding DisplayProtocol}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DisplayTransport}" Opacity="0.75" FontSize="12"/>
                                    <TextBlock Text="{Binding DisplayEndpoint}" Opacity="0.7" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayLatency}" VerticalAlignment="Center"
                                           MinWidth="56" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding Network}" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Grid.Column="4" Text="{Binding Security}" VerticalAlignment="Center" Opacity="0.7"/>
                                <Button Grid.Column="5"
                                        Content="×"
                                        ToolTip.Tip="Remove this server"
                                        Padding="8,2"
                                        MinWidth="32"
                                        FontSize="16"
                                        VerticalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="RemoveServer_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Padding="12" CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="20"
                            IsVisible="{Binding ShowTrafficStats}">
                    <TextBlock Text="{Binding UploadTrafficText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DownloadTrafficText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConnectedPingText}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CoreStatus}" FontSize="12" Opacity="0.75"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
