<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:v2rayF.ViewModels"
             x:Class="v2rayF.Views.SettingsPanel"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="4">
            <TextBlock Text="Connect" FontWeight="SemiBold" FontSize="15"/>
            <Button Content="Apply Sentinel profile" Command="{Binding ApplySentinelProfileCommand}"
                    HorizontalAlignment="Stretch"/>
            <CheckBox Content="Smart Connect" IsChecked="{Binding SmartConnectEnabled}"/>
            <CheckBox Content="Rank servers on startup" IsChecked="{Binding StartupRankServersEnabled}"/>
            <CheckBox Content="Smart Multipath" IsChecked="{Binding SmartMultipathEnabled}"
                      IsVisible="{Binding ShowXrayOnlyFeatures}"/>

            <TextBlock Text="Network" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding RoutingModes}"
                      SelectedItem="{Binding SelectedRoutingMode}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Text="Bypass China uses Bypass LAN on this core (no CN geosite). Use an Xray desktop profile for CN direct."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                       IsVisible="{Binding ShowBypassChinaSingBoxHint}"/>
            <StackPanel Spacing="8" IsVisible="{Binding ShowCustomRules}">
                <TextBlock Text="Direct (domains/IPs, one per line)" Opacity="0.8" FontSize="12"/>
                <TextBox AcceptsReturn="True" MinHeight="56" MaxHeight="90"
                         Text="{Binding CustomDirectRules}" TextWrapping="Wrap"
                         PlaceholderText="example.com"/>
                <TextBlock Text="Force proxy" Opacity="0.8" FontSize="12"/>
                <TextBox AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                         Text="{Binding CustomProxyRules}" TextWrapping="Wrap"/>
                <TextBlock Text="Block" Opacity="0.8" FontSize="12"/>
                <TextBox AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                         Text="{Binding CustomBlockRules}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Content="TUN mode (full-device VPN)" IsChecked="{Binding EnableTunMode}"
                      IsVisible="{Binding ShowDesktopProxySettings}"/>
            <CheckBox Content="Route push notifications (WNS, Telegram, Discord, Signal, Slack) via proxy"
                      IsChecked="{Binding AllowDesktopNotificationRouting}"
                      IsVisible="{Binding ShowDesktopProxySettings}"/>
            <TextBlock Text="{Binding TunStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
            <CheckBox Content="Set system HTTP proxy on connect" IsChecked="{Binding EnableSystemProxy}"
                      IsEnabled="{Binding !EnableTunMode}"
                      IsVisible="{Binding ShowDesktopProxySettings}"/>

            <TextBlock Text="Protection" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0"/>
            <CheckBox Content="Kill switch (requires TUN)" IsChecked="{Binding KillSwitchEnabled}"
                      IsEnabled="{Binding KillSwitchUsable}"
                      IsVisible="{Binding ShowDesktopProxySettings}"/>
            <TextBlock Text="Kill switch needs TUN mode; with system proxy only it would block non-proxy apps."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       IsVisible="{Binding ShowDesktopProxySettings}"/>
            <CheckBox Content="Secure DNS (DoH)" IsChecked="{Binding DnsThroughProxy}"/>
            <TextBlock Text="Encrypts DNS via DoH; can add first-page latency vs plain DNS. Off by default for snappier browsing."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
            <CheckBox Content="Block IPv6 leaks" IsChecked="{Binding BlockIpv6}"/>
            <CheckBox Content="Packet fragment (DPI, slower)" IsChecked="{Binding EnablePacketFragment}"/>
            <CheckBox Content="Adaptive Survive (DPI; can slow)" IsChecked="{Binding AdaptiveSurviveEnabled}"/>
            <CheckBox Content="Auto-reconnect after drop" IsChecked="{Binding AutoReconnectEnabled}"/>
            <CheckBox Content="Fetch subscriptions via proxy when connected"
                      IsChecked="{Binding SubscriptionViaProxy}"
                      IsVisible="{Binding ShowDesktopProxySettings}"/>
            <TextBlock Text="App Network" FontSize="12" Opacity="0.8" Margin="0,4,0,0"
                       IsVisible="{Binding ShowAppNetwork}"/>
            <TextBlock Text="Per-app VPN / Direct / Block. Direct splits out of the VPN; Block denies internet while connected."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                       IsVisible="{Binding ShowAppNetwork}"/>
            <Button Content="Open App Network"
                    Command="{Binding OpenAppNetworkCommand}"
                    IsVisible="{Binding ShowAppNetwork}"
                    HorizontalAlignment="Stretch" MinHeight="40"/>
            <TextBlock Text="Advanced Direct packages (optional)" FontSize="11" Opacity="0.65"
                       IsVisible="{Binding ShowAndroidBypass}"/>
            <TextBox AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                     Text="{Binding AndroidBypassPackages}"
                     IsVisible="{Binding ShowAndroidBypass}"
                     PlaceholderText="com.example.app"
                     TextWrapping="Wrap"/>

            <StackPanel Spacing="12" IsVisible="{Binding ShowXrayOnlyFeatures}">
                <TextBlock Text="Share" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0"/>
                <CheckBox Content="Secure Share (LAN gateway)" IsChecked="{Binding SecureShareEnabled}"/>
                <CheckBox Content="Listen on all interfaces" IsChecked="{Binding ShareListenAllInterfaces}"
                          IsVisible="{Binding SecureShareEnabled}"/>
                <TextBlock Text="{Binding SecureShareEndpoint}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                           IsVisible="{Binding SecureShareEnabled}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SecureShareEnabled}">
                    <CheckBox Content="Reveal password" IsChecked="{Binding RevealSharePassword}"
                              IsEnabled="{Binding VaultUnlocked}"/>
                    <Button Content="Copy SOCKS" Command="{Binding CopySecureShareCommand}"/>
                    <Button Content="Rotate" Command="{Binding RotateSharePasswordCommand}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="HTTP  → 127.0.0.1:10809" FontSize="12" Opacity="0.75"/>
            <TextBlock Text="SOCKS → 127.0.0.1:10808" FontSize="12" Opacity="0.75"/>

            <TextBlock Text="Vault" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Unlock" Command="{Binding UnlockVaultCommand}" IsVisible="{Binding !VaultUnlocked}"/>
                <Button Content="Lock" Command="{Binding LockVaultCommand}" IsVisible="{Binding VaultUnlocked}"/>
            </StackPanel>
            <TextBox PlaceholderText="Vault passphrase (export/import)"
                     Text="{Binding VaultPassphrase}"
                     PasswordChar="•"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export .v2rayf" Command="{Binding ExportVaultCommand}"/>
                <Button Content="Import .v2rayf" Command="{Binding ImportVaultCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
